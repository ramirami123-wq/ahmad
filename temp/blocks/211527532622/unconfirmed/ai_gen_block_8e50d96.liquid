{% doc %}
  @prompt
    Create a bold highlight banner block with two prominent messages: "Limited Launch Offer" and "Free Delivery". Display them side by side or stacked, with large eye-catching text, icons or badges, and a premium minimal style. Should stand out on a product page to drive urgency and trust.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-highlight-banner-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-highlight-banner__container-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.gap }}px;
    padding: {{ block.settings.padding }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
    width: 100%;
  }

  .ai-highlight-banner__item-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: {{ block.settings.item_padding }}px;
    background-color: {{ block.settings.item_background_color }};
    border-radius: {{ block.settings.item_border_radius }}px;
    gap: {{ block.settings.item_gap }}px;
  }

  .ai-highlight-banner__icon-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    background-color: {{ block.settings.icon_background_color }};
    border-radius: 50%;
  }

  .ai-highlight-banner__icon-{{ ai_gen_id }} {
    width: calc({{ block.settings.icon_size }}px * 0.6);
    height: calc({{ block.settings.icon_size }}px * 0.6);
    color: {{ block.settings.icon_color }};
  }

  .ai-highlight-banner__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: {{ block.settings.title_weight }};
    color: {{ block.settings.title_color }};
    margin: 0;
    line-height: 1.2;
  }

  .ai-highlight-banner__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
    line-height: 1.4;
  }

  @media screen and (max-width: 749px) {
    .ai-highlight-banner__container-{{ ai_gen_id }} {
      {% if block.settings.mobile_layout == 'stacked' %}
        flex-direction: column;
      {% else %}
        flex-direction: row;
      {% endif %}
      padding: {{ block.settings.padding_mobile }}px;
      gap: {{ block.settings.gap_mobile }}px;
    }

    .ai-highlight-banner__item-{{ ai_gen_id }} {
      padding: {{ block.settings.item_padding_mobile }}px;
    }

    .ai-highlight-banner__icon-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size_mobile }}px;
      height: {{ block.settings.icon_size_mobile }}px;
    }

    .ai-highlight-banner__icon-{{ ai_gen_id }} {
      width: calc({{ block.settings.icon_size_mobile }}px * 0.6);
      height: calc({{ block.settings.icon_size_mobile }}px * 0.6);
    }

    .ai-highlight-banner__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size_mobile }}px;
    }

    .ai-highlight-banner__subtitle-{{ ai_gen_id }} {
      font-size: {{ block.settings.subtitle_size_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-highlight-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-highlight-banner__container-{{ ai_gen_id }}">
    <div class="ai-highlight-banner__item-{{ ai_gen_id }}">
      {% if block.settings.show_icon_1 %}
        <div class="ai-highlight-banner__icon-wrapper-{{ ai_gen_id }}">
          {% if block.settings.custom_icon_1 != blank %}
            {{ block.settings.custom_icon_1 }}
          {% else %}
            <svg class="ai-highlight-banner__icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          {% endif %}
        </div>
      {% endif %}
      <h3 class="ai-highlight-banner__title-{{ ai_gen_id }}">{{ block.settings.title_1 }}</h3>
      {% if block.settings.subtitle_1 != blank %}
        <p class="ai-highlight-banner__subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle_1 }}</p>
      {% endif %}
    </div>

    <div class="ai-highlight-banner__item-{{ ai_gen_id }}">
      {% if block.settings.show_icon_2 %}
        <div class="ai-highlight-banner__icon-wrapper-{{ ai_gen_id }}">
          {% if block.settings.custom_icon_2 != blank %}
            {{ block.settings.custom_icon_2 }}
          {% else %}
            <svg class="ai-highlight-banner__icon-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="1" y="3" width="15" height="13"></rect>
              <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
              <circle cx="5.5" cy="18.5" r="2.5"></circle>
              <circle cx="18.5" cy="18.5" r="2.5"></circle>
            </svg>
          {% endif %}
        </div>
      {% endif %}
      <h3 class="ai-highlight-banner__title-{{ ai_gen_id }}">{{ block.settings.title_2 }}</h3>
      {% if block.settings.subtitle_2 != blank %}
        <p class="ai-highlight-banner__subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle_2 }}</p>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Highlight banner",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
