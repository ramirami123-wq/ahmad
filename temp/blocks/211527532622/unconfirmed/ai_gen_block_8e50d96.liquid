    {
      "type": "range",
      "id": "item_gap",
      "label": "Item content gap",
      "min": 5,
      "max": 30,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "item_border_radius",
      "label": "Item border radius",
      "min": 0,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 5
    },
    {
      "type": "color",
      "id": "item_background_color",
