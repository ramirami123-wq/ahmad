{% doc %}
  @prompt
    Create a "Why Nestora AI Companion is Different" comparison section to be placed before an existing comparison table. The section should have a bold heading "Why Nestora AI Companion is Different" and display a styled comparison table with two columns: "Others" and "Nestora". The Nestora column should be visually highlighted with accent color. Rows: 1) English only vs Arabic + 65 Languages, 2) Screen-based vs Plush Companion, 3) Generic AI vs Interactive Conversations, 4) Hard to carry vs Pocket Size. Use a clean, premium, modern design with ✗ for Others and ✓ for Nestora to make the contrast clear at a glance.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-comparison-section-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 20px;
    display: block;
  }

  .ai-comparison-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    text-align: {{ block.settings.heading_alignment }};
    color: {{ block.settings.heading_color }};
  }

  .ai-comparison-table-{{ ai_gen_id }} {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
    background-color: {{ block.settings.table_background }};
  }

  .ai-comparison-table-{{ ai_gen_id }} thead th {
    padding: {{ block.settings.cell_padding }}px;
    font-size: {{ block.settings.header_font_size }}px;
    font-weight: 600;
    text-align: center;
    border-bottom: 2px solid {{ block.settings.border_color }};
    background-color: {{ block.settings.header_background }};
    color: {{ block.settings.header_text_color }};
  }

  .ai-comparison-table-{{ ai_gen_id }} thead th:first-child {
    border-right: 1px solid {{ block.settings.border_color }};
  }

  .ai-comparison-table-{{ ai_gen_id }} thead th:last-child {
    background-color: {{ block.settings.accent_color }};
    color: {{ block.settings.accent_text_color }};
  }

  .ai-comparison-table-{{ ai_gen_id }} tbody tr {
    border-bottom: 1px solid {{ block.settings.border_color }};
  }

  .ai-comparison-table-{{ ai_gen_id }} tbody tr:last-child {
    border-bottom: none;
  }

  .ai-comparison-table-{{ ai_gen_id }} tbody td {
    padding: {{ block.settings.cell_padding }}px;
    font-size: {{ block.settings.body_font_size }}px;
    text-align: center;
    vertical-align: middle;
    color: {{ block.settings.body_text_color }};
  }

  .ai-comparison-table-{{ ai_gen_id }} tbody td:first-child {
    border-right: 1px solid {{ block.settings.border_color }};
    background-color: {{ block.settings.others_background }};
  }

  .ai-comparison-table-{{ ai_gen_id }} tbody td:last-child {
    background-color: {{ block.settings.nestora_background }};
  }

  .ai-comparison-icon-{{ ai_gen_id }} {
    font-size: {{ block.settings.icon_size }}px;
    font-weight: 700;
    display: inline-block;
  }

  .ai-comparison-icon-{{ ai_gen_id }}.negative {
    color: {{ block.settings.negative_icon_color }};
  }

  .ai-comparison-icon-{{ ai_gen_id }}.positive {
    color: {{ block.settings.positive_icon_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-comparison-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-comparison-table-{{ ai_gen_id }} thead th {
      font-size: {{ block.settings.header_font_size | times: 0.9 }}px;
      padding: {{ block.settings.cell_padding | times: 0.7 }}px;
    }

    .ai-comparison-table-{{ ai_gen_id }} tbody td {
      font-size: {{ block.settings.body_font_size | times: 0.9 }}px;
      padding: {{ block.settings.cell_padding | times: 0.7 }}px;
    }

    .ai-comparison-icon-{{ ai_gen_id }} {
      font-size: {{ block.settings.icon_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-comparison-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <h2 class="ai-comparison-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
  
  <table class="ai-comparison-table-{{ ai_gen_id }}">
    <thead>
      <tr>
        <th>{{ block.settings.others_label }}</th>
        <th>{{ block.settings.nestora_label }}</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>
          <span class="ai-comparison-icon-{{ ai_gen_id }} negative">✗</span>
          {{ block.settings.row_1_others }}
        </td>
        <td>
          <span class="ai-comparison-icon-{{ ai_gen_id }} positive">✓</span>
          {{ block.settings.row_1_nestora }}
        </td>
      </tr>
      <tr>
        <td>
          <span class="ai-comparison-icon-{{ ai_gen_id }} negative">✗</span>
          {{ block.settings.row_2_others }}
        </td>
        <td>
          <span class="ai-comparison-icon-{{ ai_gen_id }} positive">✓</span>
          {{ block.settings.row_2_nestora }}
        </td>
      </tr>
      <tr>
        <td>
          <span class="ai-comparison-icon-{{ ai_gen_id }} negative">✗</span>
          {{ block.settings.row_3_others }}
        </td>
        <td>
          <span class="ai-comparison-icon-{{ ai_gen_id }} positive">✓</span>
          {{ block.settings.row_3_nestora }}
        </td>
      </tr>
      <tr>
        <td>
          <span class="ai-comparison-icon-{{ ai_gen_id }} negative">✗</span>
          {{ block.settings.row_4_others }}
        </td>
        <td>
          <span class="ai-comparison-icon-{{ ai_gen_id }} positive">✓</span>
          {{ block.settings.row_4_nestora }}
        </td>
      </tr>
    </tbody>
  </table>
</div>

